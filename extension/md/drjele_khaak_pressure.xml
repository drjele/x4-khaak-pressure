<?xml version="1.0" encoding="utf-8"?>
<mdscript name="DrJele_KhaakPressure" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
    <cues>

        <cue name="Configuration" instantiate="true" namespace="static" version="1">
            <conditions>
                <event_cue_signalled cue="md.Setup.Start"/>
            </conditions>
            <actions>
                <set_value name="$HiveGateRange" exact="3" comment="gate jumps within which a hive may place an outpost, and the radius of the sectors it watches; 3 is vanilla"/>
                <set_value name="$OutpostThreshold" exact="50000" comment="mining activity a sector must reach before the Kha'ak look for somewhere to place an outpost; 50000 is vanilla"/>
                <set_value name="$SpawnChanceFactor" exact="1" comment="multiplies the chance that mining next to an outpost spawns a Kha'ak group; 1 is vanilla"/>
                <set_value name="$DebugChance" exact="0" comment="100 writes every applied change to the debug log"/>

                <set_value name="global.$DrJeleKhaakPressureConfig" exact="table[$HiveGateRange     = $HiveGateRange,
                                                                          $OutpostThreshold  = $OutpostThreshold,
                                                                          $SpawnChanceFactor = $SpawnChanceFactor,
                                                                          $DebugChance       = $DebugChance]"/>
            </actions>
        </cue>

        <cue name="Apply" instantiate="true" version="1">
            <conditions>
                <event_cue_signalled cue="md.Setup.Start"/>
                <check_value value="macro.xu_ep2_universe_macro == player.galaxy.macro" comment="the same guard the vanilla manager uses; without it the child below would poll forever in a Timelines scenario, a tutorial or the workshop map, where the Kha'ak manager never initialises"/>
            </conditions>
            <cues>
                <cue name="ApplyWhenManagerReady" checkinterval="5s">
                    <conditions>
                        <check_value value="md.Khaak_Activity.Manager.$HiveStationGateRange?"/>
                    </conditions>
                    <actions>
                        <include_actions ref="ApplySettings"/>
                    </actions>
                </cue>
            </cues>
        </cue>

        <!-- Signalled by the options menu when a slider moves. -->
        <cue name="Reapply" instantiate="true">
            <conditions>
                <event_cue_signalled/>
                <check_value value="md.Khaak_Activity.Manager.$HiveStationGateRange?"/>
            </conditions>
            <actions>
                <include_actions ref="ApplySettings"/>
            </actions>
        </cue>

        <library name="ApplySettings">
            <actions>
                <set_value name="$Config" exact="if global.$DrJeleKhaakPressureConfig? then global.$DrJeleKhaakPressureConfig else table[]"/>
                <set_value name="$DebugChance" exact="if $Config.$DebugChance? then $Config.$DebugChance else 0"/>

                <set_value name="$GateRange" exact="if global.$DrJeleKhaakHiveGateRange? then global.$DrJeleKhaakHiveGateRange else (if $Config.$HiveGateRange? then $Config.$HiveGateRange else 3)"/>
                <set_value name="$Threshold" exact="if global.$DrJeleKhaakOutpostThreshold? then global.$DrJeleKhaakOutpostThreshold else (if $Config.$OutpostThreshold? then $Config.$OutpostThreshold else 50000)"/>

                <set_value name="$MinThreshold" exact="$Threshold / 2"/>

                <set_value name="md.Khaak_Activity.Manager.$SpawnOutpostThreshold" exact="$Threshold"/>
                <set_value name="md.Khaak_Activity.Manager.$MinSpawnOutpostThreshold" exact="$MinThreshold"/>

                <do_if value="md.Khaak_Activity.Manager.$HiveStationGateRange != $GateRange">
                    <debug_text text="'DrJele Khaak Pressure: gate range %s -> %s, outpost threshold %s (min %s)'.[md.Khaak_Activity.Manager.$HiveStationGateRange, $GateRange, $Threshold, $MinThreshold]" chance="$DebugChance"/>
                    <set_value name="md.Khaak_Activity.Manager.$HiveStationGateRange" exact="$GateRange"/>
                    <include_actions ref="RebuildWatchedSectors"/>
                </do_if>
            </actions>
        </library>

        <library name="RebuildWatchedSectors">
            <actions>
                <set_value name="$DebugChance" exact="if global.$DrJeleKhaakPressureConfig? then global.$DrJeleKhaakPressureConfig.$DebugChance else 0"/>
                <set_value name="$ValidSectors" exact="[]"/>
                <do_for_each name="$Hive" in="md.Khaak_Activity.Manager.$HiveStations">
                    <find_sector_in_range name="$ValidSectors" object="$Hive"
                                          excluded="md.Khaak_Activity.Manager.$IgnoredSectors"
                                          maxdistance="md.Khaak_Activity.Manager.$HiveStationGateRange"
                                          multiple="true" append="true"/>
                </do_for_each>
                <do_for_each name="$Outpost" in="md.Khaak_Activity.Manager.$Outposts">
                    <append_to_list name="$ValidSectors" exact="$Outpost.sector"/>
                </do_for_each>

                <!-- Groups are sets, so adding one that is already in is free. -->
                <do_for_each name="$Sector" in="$ValidSectors">
                    <add_to_group groupname="md.Khaak_Activity.Manager.$WatchedSectors" object="$Sector"/>
                </do_for_each>

                <set_value name="$OldSectors" exact="md.Khaak_Activity.Manager.$WatchedSectors.list"/>
                <do_for_each name="$Sector" in="$OldSectors">
                    <do_if value="0 == $ValidSectors.indexof.{$Sector}">
                        <remove_value name="md.Khaak_Activity.Manager.$SectorMiningActivityTable.{$Sector}"/>
                        <remove_value name="md.Khaak_Activity.Manager.$SectorKhaakActivityTable.{$Sector}"/>
                        <remove_from_group group="md.Khaak_Activity.Manager.$WatchedSectors" object="$Sector"/>
                    </do_if>
                </do_for_each>

                <debug_text text="'DrJele Khaak Pressure: watching %s sectors after rebuild'.[md.Khaak_Activity.Manager.$WatchedSectors.count]" chance="$DebugChance"/>

                <remove_value name="$ValidSectors"/>
                <remove_value name="$OldSectors"/>
            </actions>
        </library>

    </cues>
</mdscript>
